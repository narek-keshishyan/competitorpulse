{
  "name": "@competitorpulse/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../.env src/main.ts",
    "start": "node dist/main.js",
    "migrate": "tsx --env-file-if-exists=../.env src/scripts/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@competitorpulse/shared": "0.1.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "kysely": "^0.29.7",
    "openai": "^7.39.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
