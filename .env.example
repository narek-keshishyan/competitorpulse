# Copy to .env for `npm run dev`. docker compose sets these itself.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/competitorpulse
# DATABASE_SSL=true            # needed for hosted Postgres such as Supabase

# How often each tracked competitor is polled (production would use 900).
POLL_INTERVAL_SECONDS=60

# Any OpenAI-compatible Chat Completions endpoint. Defaults to the bundled mock server.
LLM_BASE_URL=http://localhost:4001/v1
LLM_API_KEY=not-needed-for-mock
LLM_MODEL=mock-llm
